# =========================
# Compiler
# =========================
CXX = clang++

# =========================
# Flags
# =========================
COMMON_FLAGS  = -std=c++20 -Wall -Wextra
DEBUG_FLAGS   = $(COMMON_FLAGS) -O0 -g -DDEBUG
RELEASE_FLAGS = $(COMMON_FLAGS) -O2

# Default to release
CXXFLAGS = $(RELEASE_FLAGS)

INCLUDES = -Iinclude -Ithird_party

# =========================
# Directories
# =========================
SRC_DIR     = src
INCLUDE_DIR = include
TEST_DIR    = tests
BENCH_DIR   = bench
CLI_DIR     = cli
BUILD_DIR   = build
BIN_DIR     = bin
LOG_DIR     = logs

# =========================
# Sources / Objects
# =========================
SOURCES = \
	$(SRC_DIR)/main.cpp \
	$(SRC_DIR)/orderbook.cpp \
	$(SRC_DIR)/engine.cpp \
	$(SRC_DIR)/arena.cpp \
	$(SRC_DIR)/logger.cpp \
	$(SRC_DIR)/exchange.cpp \
	$(SRC_DIR)/sequencer.cpp \
	$(SRC_DIR)/events.cpp

OBJECTS = $(SOURCES:$(SRC_DIR)/%.cpp=$(BUILD_DIR)/%.o)

# Library objects = everything except main, shared with the test binary
LIB_OBJECTS = $(filter-out $(BUILD_DIR)/main.o,$(OBJECTS))

TEST_SOURCES = $(wildcard $(TEST_DIR)/*.cpp)
TEST_OBJECTS = $(TEST_SOURCES:$(TEST_DIR)/%.cpp=$(BUILD_DIR)/tests/%.o)

# =========================
# Target
# =========================
TARGET      = $(BIN_DIR)/main
TEST_TARGET = $(BIN_DIR)/tests
BENCH_TARGET = $(BIN_DIR)/bench
CLI_TARGET  = $(BIN_DIR)/mktsim
CLI_SOURCES = $(wildcard $(CLI_DIR)/*.cpp)
CLI_OBJECTS = $(CLI_SOURCES:$(CLI_DIR)/%.cpp=$(BUILD_DIR)/cli/%.o)

# =========================
# Targets
# =========================

all: directories $(TARGET)

# Debug build
debug: CXXFLAGS = $(DEBUG_FLAGS)
debug: clean all

# Create directories
directories:
	@mkdir -p $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)/tests
	@mkdir -p $(BUILD_DIR)/cli
	@mkdir -p $(BIN_DIR)
	@mkdir -p $(LOG_DIR)

# Link
$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(OBJECTS) -o $(TARGET)
	@echo "Build complete: $(TARGET)"

# Compile (with automatic header dependency tracking)
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -MMD -MP -c $< -o $@

# Run
run: $(TARGET)
	./$(TARGET)

# =========================
# Tests
# =========================
# Build and run the test binary. Pass a substring to run a subset:
#   make test                 run everything
#   make test FILTER=engine   run tests whose name contains "engine"
test: directories $(TEST_TARGET)
	./$(TEST_TARGET) $(FILTER)

$(TEST_TARGET): $(LIB_OBJECTS) $(TEST_OBJECTS)
	$(CXX) $(CXXFLAGS) $(LIB_OBJECTS) $(TEST_OBJECTS) -o $(TEST_TARGET)
	@echo "Build complete: $(TEST_TARGET)"

$(BUILD_DIR)/tests/%.o: $(TEST_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -I$(TEST_DIR) -MMD -MP -c $< -o $@

# =========================
# Benchmark
# =========================
# Always built with release flags; N overrides the op count: make bench N=500000
bench: directories $(BENCH_TARGET)
	./$(BENCH_TARGET) $(N)

$(BENCH_TARGET): $(LIB_OBJECTS) $(BUILD_DIR)/bench_main.o
	$(CXX) $(RELEASE_FLAGS) $(LIB_OBJECTS) $(BUILD_DIR)/bench_main.o -o $(BENCH_TARGET)

$(BUILD_DIR)/bench_main.o: $(BENCH_DIR)/bench_main.cpp
	$(CXX) $(RELEASE_FLAGS) $(INCLUDES) -MMD -MP -c $< -o $@

# =========================
# CLI
# =========================
# make cli            builds bin/mktsim
# make cli-test       runs every cli/scenarios/*.txt and fails on any error
cli: directories $(CLI_TARGET)

$(CLI_TARGET): $(LIB_OBJECTS) $(CLI_OBJECTS)
	$(CXX) $(CXXFLAGS) $(LIB_OBJECTS) $(CLI_OBJECTS) -o $(CLI_TARGET)
	@echo "Build complete: $(CLI_TARGET)"

$(BUILD_DIR)/cli/%.o: $(CLI_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -I$(CLI_DIR) -MMD -MP -c $< -o $@

cli-test: cli
	@for f in $(CLI_DIR)/scenarios/*.txt; do \
	  printf '%s: ' $$f; \
	  if ./$(CLI_TARGET) run $$f ../configs/default.json >/dev/null 2>$(BUILD_DIR)/cli/err.txt; then echo ok; \
	  else echo FAIL; cat $(BUILD_DIR)/cli/err.txt; exit 1; fi; \
	done

# Pull in header dependencies generated by -MMD
-include $(OBJECTS:.o=.d) $(TEST_OBJECTS:.o=.d) $(BUILD_DIR)/bench_main.d $(CLI_OBJECTS:.o=.d)

# Clean
clean:
	rm -rf $(BUILD_DIR) $(BIN_DIR)
	@echo "Clean complete"

# Rebuild
rebuild: clean all

# Clear logs
clear:
	rm -rf $(LOG_DIR)
	@echo "Cleared all logs"

.PHONY: all debug clean run rebuild directories clear test bench cli cli-test
